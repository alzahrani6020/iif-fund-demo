# Cloudflare Pages redirects (must live at publish root)
# Syntax: <from> <to> [<status>]
# ملاحظة: لا قواعد rewrite إلى ملفات .html — Pages يحوّل /x.html تلقائيًا بـ 308 إلى /x
# فينشأ حلقة لا نهائية. المسارات مثل /admin و/news-sources تُقدَّم تلقائيًا من ملفات HTML
# عبر clean URLs دون أي قاعدة.

/fund        /index.html         200
/fund/       /index.html         200

/dashboard   /index.html?iif_admin_portal=1&open_dashboard=1 200
/dashboard/  /index.html?iif_admin_portal=1&open_dashboard=1 200
/panel       /index.html?iif_admin_portal=1&open_dashboard=1 200
/panel/      /index.html?iif_admin_portal=1&open_dashboard=1 200
/cp          /index.html?iif_admin_portal=1&open_dashboard=1 200
/cp/         /index.html?iif_admin_portal=1&open_dashboard=1 200
/fund-admin  /index.html?iif_admin_portal=1&open_dashboard=1 200
/fund-admin/ /index.html?iif_admin_portal=1&open_dashboard=1 200

# Executive brief + sovereign standards + legal (محتوى من جذر المستودع نُقل إلى مجلد النشر)
/executive  /executive-brief  301
/brief      /executive-brief  301
/sovereign  /sovereign-standards  301
/charter    /sovereign-standards  301
/legal      /legal/  301
/disclaimer /legal/disclaimer  301

/gov        /gov/  301
/fund-site  /fund-site/  301

# Optional trailing-slash consistency
/index.html / 301
