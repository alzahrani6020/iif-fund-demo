# Database (PostgreSQL required for production)
# Example local:  postgresql://user:password@localhost:5432/afaq
# Example Neon:   postgresql://user:password@host.neon.tech/db?sslmode=require
DATABASE_URL=

# File uploads
# STORAGE_PROVIDER: "local" for development, "blob" for Vercel Production.
# When "blob" is used, BLOB_READ_WRITE_TOKEN is required and files are stored
# in Vercel Blob (persistent object storage). UPLOAD_DIR is only used for local.
STORAGE_PROVIDER=local
UPLOAD_DIR=./public/uploads
UPLOAD_PUBLIC_PREFIX=/uploads
MAX_FILE_SIZE=10485760

# Vercel Blob (required in Production when STORAGE_PROVIDER=blob)
# Get the token from your Vercel Dashboard: Project → Storage → Blob → Connect Store.
BLOB_READ_WRITE_TOKEN=

# WhatsApp integration
WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Admin session secret (must be at least 32 characters long)
ADMIN_SESSION_SECRET=

# Email provider: "smtp" (recommended for Zoho Mail) or "zoho" (Zoho Mail API via OAuth)
EMAIL_PROVIDER=smtp

# Sender identity (production: info@bonds-global.com)
EMAIL_FROM=info@bonds-global.com
EMAIL_FROM_NAME="AFAQ | آفاق"

# Application base URL used in verification links
NEXT_PUBLIC_APP_URL=https://afaq-global.com

# SMTP settings for Zoho Mail (recommended)
# Use an App Password, never the account login password.
# For Vercel serverless functions, set UPLOAD_DIR=/tmp/uploads as a temporary
# writable path until cloud object storage (R2/S3/Vercel Blob) is configured.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@bonds-global.com
SMTP_PASSWORD=

# Zoho Mail API via OAuth (only needed if EMAIL_PROVIDER=zoho)
# These must be obtained from the Zoho API Console and OAuth callback flow.
ZOHO_ACCOUNTS_DOMAIN=accounts.zoho.com
ZOHO_MAIL_API_DOMAIN=mail.zoho.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=
ZOHO_OAUTH_STATE=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=
